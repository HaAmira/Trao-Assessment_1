# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

MONGODB_URI=
JWT_SECRET=replace_this_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# LLM Providers (Genuinely Free Tier Available)
# 1. Google Gemini (Free API Key available at: https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Groq (Free fast inference API Key available at: https://console.groq.com/)
GROQ_API_KEY=

# 3. Optional OpenAI or OpenAI-Compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Preferred LLM Provider selection: 'auto' | 'gemini' | 'groq' | 'openai' | 'mock'
# 'auto' automatically detects Gemini, Groq, or OpenAI keys, falling back gracefully to deterministic generator.
LLM_PROVIDER=auto
